#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

// MoE Routing Shader — Suporte Dinâmico e Ilimitado de Experts
//
// num_experts é um push_constant: pode ser 8, 64, 256, 1024 ou qualquer valor.
// Não existe MAX_EXPERTS hardcoded.
//
// Modelos suportados (e qualquer futuro):
//   Mixtral 8x7B / 8x22B → num_experts=8,   top_k=2
//   Qwen MoE             → num_experts=64,  top_k=4
//   DeepSeek-MoE V1      → num_experts=64,  top_k=6
//   DeepSeek V2/V3       → num_experts=256, top_k=6  (fine-grained experts)
//   Modelos futuros      → num_experts=N,   top_k=K  (sem recompilar o shader)
//
// Arquitetura:
//   - expert_scores[] e selection_bitmap[] vivem em SSBOs (binding 4 e 5),
//     não em shared memory — tamanho calculado em runtime por token.
//   - Bitmap de seleção: ceil(num_experts / 32) uint32s por token.
//   - atomicOr() garante consistência sem race condition entre lanes top_k.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// ── Bindings de I/O ─────────────────────────────────────────────────────────
layout(std430, binding = 0) readonly buffer InputBuffer {
    float input_x[]; // [seq_len * hidden_dim]
};

layout(std430, binding = 1) readonly buffer GateWeightsBuffer {
    // Expert e → offset e * ceil(hidden_dim / 32) uint32s (RaBitQ 1-bit)
    uint gate_weights_1bit[];
};

layout(std430, binding = 2) writeonly buffer TopKIndicesBuffer {
    uint out_topk_indices[]; // [seq_len * top_k]
};

layout(std430, binding = 3) writeonly buffer TopKScoresBuffer {
    float out_topk_scores[]; // [seq_len * top_k]
};

// ── Buffers intermediários (tamanho calculado em runtime) ───────────────────
layout(std430, binding = 4) buffer ExpertScoresBuffer {
    // [seq_len * num_experts] floats — alocado pelo host antes do dispatch
    float expert_scores[];
};

layout(std430, binding = 5) buffer SelectionBitmapBuffer {
    // [seq_len * ceil(num_experts/32)] uint32s — alocado pelo host
    uint selection_bitmap[];
};

// ── Push constants — todos os parâmetros são runtime ───────────────────────
layout(push_constant) uniform PushConstants {
    uint seq_len;
    uint hidden_dim;
    uint num_experts; // sem limite de compilação — qualquer valor
    uint top_k;       // normalmente ≤ 16
    // routing_mode: 0 = top-k padrão (Selection Sort)
    //               1 = HARD k=1 (Esparsidade Extrema — 1 expert determinístico)
    // Modo k=1 elimina o "Paradoxo da Densidade Temporal" descrito na pesquisa:
    // ao ativar apenas 1 expert por camada, a cascata de page faults no SSD
    // é estancada, permitindo prefetch preditivo One-Token-Lag.
    uint routing_mode;
} pc;

void main() {
    uint tx        = gl_LocalInvocationID.x;  // lane 0..31
    uint token_idx = gl_WorkGroupID.x;

    if (token_idx >= pc.seq_len) return;

    // Offsets calculados em runtime para este token
    uint words_per_expert = (pc.hidden_dim + 31u) / 32u;
    uint bitmap_words     = (pc.num_experts + 31u) / 32u;
    uint input_base       = token_idx * pc.hidden_dim;
    uint scores_base      = token_idx * pc.num_experts;
    uint bitmap_base      = token_idx * bitmap_words;

    // ── Inicializa scores e bitmap deste token ─────────────────────────────
    for (uint e = tx; e < pc.num_experts; e += 32u) {
        expert_scores[scores_base + e] = 0.0;
    }
    for (uint w = tx; w < bitmap_words; w += 32u) {
        selection_bitmap[bitmap_base + w] = 0u;
    }

    // Garante visibilidade dos zeros antes de calcular scores
    // (memoryBarrierBuffer é suficiente pois usamos SSBO, não shared mem)
    memoryBarrierBuffer();
    barrier();

    // ── Passo 1: Dot product 1-bit (XNOR + popcount) para cada expert ─────
    for (uint expert_id = 0u; expert_id < pc.num_experts; expert_id++) {
        uint gate_base    = expert_id * words_per_expert;
        uint popcount_sum = 0u;

        // Cada lane trata stride de 32 palavras do vetor do expert
        for (uint w = tx; w < words_per_expert; w += 32u) {
            // Quantiza 32 floats do input em 1 bit por elemento (sinal)
            uint input_bits = 0u;
            for (uint bit = 0u; bit < 32u; bit++) {
                uint elem_idx = w * 32u + bit;
                if (elem_idx < pc.hidden_dim) {
                    if (input_x[input_base + elem_idx] >= 0.0) {
                        input_bits |= (1u << bit);
                    }
                }
            }

            uint gate_bits = gate_weights_1bit[gate_base + w];
            // XNOR: conta concordâncias de sinal
            popcount_sum += bitCount(~(input_bits ^ gate_bits));
        }

        // Subgroup reduction: agrega parciais de todas as 32 lanes em 1 instrução
        uint total_pop = subgroupAdd(popcount_sum);

        // Lane 0 escreve o score normalizado [-1, 1] no SSBO
        if (tx == 0u) {
            expert_scores[scores_base + expert_id] =
                (2.0 * float(total_pop) / float(pc.hidden_dim)) - 1.0;
        }
    }

    // Garante que todos os scores estão escritos antes do sort/seleção
    memoryBarrierBuffer();
    barrier();

    // ── Passo 2: Seleção de Experts ────────────────────────────────────────
    //
    // MODO 0 (top-k): Selection Sort com bitmap dinâmico no SSBO.
    //   Apenas as lanes tx < top_k participam do sort.
    //   Selection sort: O(num_experts × top_k) — ótimo para top_k ≤ 16.
    //
    // MODO 1 (HARD k=1): Redução paralela determinística.
    //   Apenas lane 0 escreve. Zero bitmap, zero sort.
    //   Complexidade: O(num_experts) — um único scan.
    //   Elimina cascata de page faults (Paradoxo da Densidade Temporal).

    if (pc.routing_mode == 1u) {
        // ── HARD ROUTING k=1 ───────────────────────────────────────────────
        // Cada lane encontra o melhor expert no seu stride via redução local,
        // depois subgroupMax colapsa todas as lanes em 1 instrução.
        float local_best_score = -1e30;
        uint  local_best_idx   = 0u;

        for (uint e = tx; e < pc.num_experts; e += 32u) {
            float s = expert_scores[scores_base + e];
            if (s > local_best_score) {
                local_best_score = s;
                local_best_idx   = e;
            }
        }

        // Subgroup reduction: encontra o máximo global entre as 32 lanes
        float global_best_score = subgroupMax(local_best_score);

        // A lane que detém o vencedor global escreve o resultado
        // (em caso de empate, a lane com menor ID ganha — determinístico)
        bool i_am_winner = (local_best_score == global_best_score);
        uint winner_lane = subgroupBallotFindLSB(subgroupBallot(i_am_winner));

        if (tx == winner_lane) {
            uint base_out = token_idx * pc.top_k;
            out_topk_indices[base_out] = local_best_idx;
            out_topk_scores [base_out] = local_best_score;

            // Preenche slots restantes com sentinela (0xFFFFFFFF = inválido)
            for (uint k = 1u; k < pc.top_k; k++) {
                out_topk_indices[base_out + k] = 0xFFFFFFFFu;
                out_topk_scores [base_out + k] = -1e30;
            }
        }
    } else {
        // ── TOP-K SELECTION SORT (modo padrão) ─────────────────────────────
        if (tx < pc.top_k) {
            uint base_out = token_idx * pc.top_k;

            for (uint k = 0u; k < pc.top_k; k++) {
                float best_score = -1e30;
                uint  best_idx   = 0u;

                // Busca o expert não selecionado com maior score
                for (uint e = 0u; e < pc.num_experts; e++) {
                    uint word    = e / 32u;
                    uint bit_pos = e % 32u;
                    bool already = bool(
                        (selection_bitmap[bitmap_base + word] >> bit_pos) & 1u
                    );

                    if (!already && expert_scores[scores_base + e] > best_score) {
                        best_score = expert_scores[scores_base + e];
                        best_idx   = e;
                    }
                }

                // A lane tx == k escreve o k-ésimo expert escolhido
                if (tx == k) {
                    out_topk_indices[base_out + k] = best_idx;
                    out_topk_scores [base_out + k] = best_score;
                }

                // Todas as lanes top_k marcam o mesmo expert via atomicOr
                // (best_idx é idêntico em todas as lanes — sem divergência)
                uint word    = best_idx / 32u;
                uint bit_pos = best_idx % 32u;
                atomicOr(selection_bitmap[bitmap_base + word], (1u << bit_pos));

                // Barreira leve para garantir visibilidade do bitmap antes da próxima iteração
                memoryBarrierBuffer();
            }
        }
    }
}
