#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer MatrixA { float a[]; }; 
layout(std430, set = 0, binding = 1) readonly buffer MatrixB { uint b[]; }; // Q4_0 packed structs
layout(std430, set = 0, binding = 2) buffer MatrixOutput { float output_data[]; };

layout(push_constant) uniform PushConstants {
    uint m;
    uint k;
    uint n;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    
    if (row >= pc.m || col >= pc.n) return;

    // Fused Q4_0 Dequant + Matmul Stub
    // Num modelo GGML, cada block Q4_0 = 1 float16 (escala) + 16 bytes (32 pesos 4-bit)
    // No shader nós carregaríamos 'd' e faríamos dot product on-the-fly p/ economizar VRAM
    
    float sum = 0.0;
    
    // Fake loop to prevent optimization leaving buffers unused
    // We treat b[] as raw uints for the stub
    for(uint i = 0; i < 1; i++) {
        sum += a[row * pc.k] * float(b[col]);
    }

    output_data[row * pc.n + col] = sum;
}
